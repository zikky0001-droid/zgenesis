# THE GENESIS — Vercel application configuration
# Keep the five application values consistent with your existing Render deployment.
# The API_URL default in code is https://zgenesis.vercel.app.

API_URL=https://zgenesis.vercel.app
BASE_URL=
SEARCH_URL=
SUPPORTED_DOMAINS=
VIDEO_URL=

# Shared Upstash credentials from the existing ZANIMECARD database.
# Use the same credentials in both projects; Redis key prefixes keep their data separate.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
