# THE GENESIS — Vercel application configuration
# Keep these five application values consistent with your existing Render deployment.
# The API_URL default in code is https://zgenesis.vercel.app.

API_URL=https://zgenesis.vercel.app
BASE_URL=
SEARCH_URL=
SUPPORTED_DOMAINS=
VIDEO_URL=

# Shared Upstash credentials from the existing ZANIMECARD database.
# These are additional infrastructure credentials, not application source settings.
# Use the same credentials in both projects; distinct key prefixes isolate their counters.
# If Redis is unavailable, THE GENESIS continues serving API requests (fail-open).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# DEBUG_LOGS is a source-level constant in server.js (default false); it is not an environment variable.
