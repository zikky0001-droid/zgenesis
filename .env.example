# ============================================
# THE GENESIS - ENVIRONMENT VARIABLES
# Copy to ".env" for local use:  cp .env.example .env
# On Render: add each one under Dashboard > Environment
# Every variable is OPTIONAL. If missing/invalid, the default shown is used.
# Do NOT wrap values in quotes or brackets on Render.
# ============================================

# ----- Server -----
PORT=10000
NODE_ENV=production

# ----- Scraping source URLs -----
# Homepage to scrape (trailing "/" added automatically)
BASE_URL=https://amp.ccxx.com/

# Search URL - the search term is appended to the end
SEARCH_URL=https://amp.ccxx.com/search/

# Video page prefix - the video ID is appended (KEEP the "video-" ending)
VIDEO_URL=https://www.ccxx.com/video-

# Your own deployed app URL
API_URL=https://zgenesis.onrender.com

# ----- Domains -----
# Comma-separated, no quotes/brackets. Subdomains match automatically
# (ccxx.com also covers www.ccxx.com).
SUPPORTED_DOMAINS=amp.ccxx.com,ccxx.com,cchh.com,thnxx.com,txnhh.com

# Alias domain rewrites applied before scraping, format: from=to,from2=to2
# Default matches the old hardcoded behaviour (txnhh.com -> ccxx.com).
# NOTE: setting this REPLACES the default, so include txnhh.com=ccxx.com if you still want it.
HOST_REWRITES=txnhh.com=ccxx.com

# ----- Optional security -----
# true = /api/video/by-url only accepts hosts listed in SUPPORTED_DOMAINS
# (blocks the server being used as an open proxy). Default: false
ENFORCE_DOMAIN_CHECK=false
